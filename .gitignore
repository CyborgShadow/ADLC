# The ledger is the record; the runtime state around it is not.
.adlc/

# Built binaries, anchored so the pattern cannot swallow cmd/adlc/.
/adlc
/adlc.exe

*.db
*.db-shm
*.db-wal

.claude/worktrees/

# The per-run brief, written to each workspace root by internal/dispatch.
# Not covered by .adlc/ above — that matches the directory, not a file whose
# name merely starts with it — so a run doing `git add -A` committed its own
# prompt onto the branch it was about to be judged on. The decision to ignore it
# was taken and recorded (docs/decisions-overnight.md, S1-022-Q1); the one line
# it needed never landed.
.adlc-prompt.md
